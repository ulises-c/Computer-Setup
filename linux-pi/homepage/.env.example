# Copy to .env and fill in. Repo is public — real values stay in .env, never committed.

# Direct LAN identities accepted by Homepage when Tailscale is unavailable.
HOMEPAGE_VAR_PI_HOSTNAME=<pi-hostname>
HOMEPAGE_VAR_PI_LAN_IP=<pi-lan-ip>

# The Pi host node's MagicDNS name. Used for HOMEPAGE_ALLOWED_HOSTS, the main
# server's link to this dashboard, and every card link to a Pi service: a path
# (https://<this>/motioneye/) or a registry port (https://<this>:8443/).
HOMEPAGE_VAR_PI_HOMEPAGE_DOMAIN=<pi-hostname>.<tailnet>.ts.net

# The main server's host node MagicDNS name — for the main server card in the
# "Servers" group (link + status monitor). Every homepage carries the same group.
HOMEPAGE_VAR_MAIN_HOMEPAGE_DOMAIN=<server>.<tailnet>.ts.net
# Game server's homepage (host Tailscale Serve), for the Servers cards.
HOMEPAGE_VAR_GAME_HOMEPAGE_DOMAIN=<game-hostname>.<tailnet>.ts.net

# AdGuard admin credentials for the Pi's backup-DNS stats widget.
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=
