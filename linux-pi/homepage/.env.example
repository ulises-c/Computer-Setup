# Copy to .env and fill in. Repo is public — real values stay in .env, never committed.

# Tailscale auth for homepage-pi-ts (same OAuth client secret as the other sidecars).
TS_AUTHKEY=

# Direct LAN identities accepted by Homepage when Tailscale is unavailable.
HOMEPAGE_VAR_PI_HOSTNAME=<pi-hostname>
HOMEPAGE_VAR_PI_LAN_IP=<pi-lan-ip>

# This homepage's own tailnet hostname (used for HOMEPAGE_ALLOWED_HOSTS + the main
# server's link to it).
HOMEPAGE_VAR_PI_HOMEPAGE_DOMAIN=homepage-pi.<tailnet>.ts.net

# The Pi's own tailnet node (host `tailscale serve`): Glances, Cockpit, Portainer.
HOMEPAGE_VAR_PI_NODE_DOMAIN=<pi-hostname>.<tailnet>.ts.net

# Pi service sidecar hostnames (per-service HTTPS front doors).
HOMEPAGE_VAR_ADGUARD_PI_DOMAIN=adguard-pi.<tailnet>.ts.net
HOMEPAGE_VAR_MOTIONEYE_DOMAIN=motioneye-pi.<tailnet>.ts.net
HOMEPAGE_VAR_CUPS_DOMAIN=cups-pi.<tailnet>.ts.net

# Main server's homepage — for the main server card in the "Servers" group
# (link + status monitor). Every homepage carries the same group.
HOMEPAGE_VAR_MAIN_HOMEPAGE_DOMAIN=homepage.<tailnet>.ts.net
# Game server's homepage (host Tailscale Serve), for the Servers cards.
HOMEPAGE_VAR_GAME_HOMEPAGE_DOMAIN=<game-hostname>.<tailnet>.ts.net
# The main server's Glances, for the live stats on its Servers card.
HOMEPAGE_VAR_MAIN_GLANCES_URL=https://glances.<tailnet>.ts.net
# Uptime Kuma, ntfy, Forgejo, AdGuard, Immich and Syncthing on the main server,
# for the Shared services cards.
HOMEPAGE_VAR_UPTIMEKUMA_DOMAIN=uptime-kuma.<tailnet>.ts.net
HOMEPAGE_VAR_NTFY_DOMAIN=ntfy.<tailnet>.ts.net
HOMEPAGE_VAR_FORGEJO_DOMAIN=forgejo.<tailnet>.ts.net
HOMEPAGE_VAR_ADGUARD_DOMAIN=adguard.<tailnet>.ts.net
HOMEPAGE_VAR_IMMICH_DOMAIN=immich.<tailnet>.ts.net
HOMEPAGE_VAR_SYNCTHING_DOMAIN=syncthing.<tailnet>.ts.net

# AdGuard admin credentials for the Pi's backup-DNS stats widget.
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=
