# Copy this file to .env and fill in real values. See ../README.md.
# Repo is public — keep real IPs and credentials in .env only, never committed.

# --- Origin: the PRIMARY AdGuard on the main server ---
# The primary admin API is exposed only by its Tailscale HTTPS sidecar.
# If the tailnet is unavailable, sync pauses and the replica keeps its last-good config.
ORIGIN_URL=https://adguard.<tailnet>.ts.net
ORIGIN_USERNAME=<admin-user>
ORIGIN_PASSWORD=<admin-password>

# --- Replica 1: this Pi's local AdGuard ---
# Pi's LAN IP (the sync container is bridged, so localhost won't reach the host).
REPLICA1_URL=http://<pi-lan-ip>
REPLICA1_USERNAME=<admin-user>
REPLICA1_PASSWORD=<admin-password>

# --- Replica 2: the game server's AdGuard (linux-game-server/adguard) ---
# LAN-only UI port; credentials are ADGUARD_USER/ADGUARD_PASSWORD from that .env.
# Leave REPLICA2_AUTO_SETUP unset: its setup.sh does the first-run install, and
# auto-setup would expect the wizard on :3000, which Homepage owns there.
REPLICA2_URL=http://<game-lan-ip>:3053
REPLICA2_USERNAME=<admin-user>
REPLICA2_PASSWORD=<admin-password>

# --- Schedule ---
CRON=*/10 * * * *
RUN_ON_START=true

# --- Feature toggles ---
# Don't sync DHCP: the router does DHCP; AdGuard's DHCP is off on every instance.
# Everything else (DNS upstreams, rewrites, filters, services, rules) syncs by
# default so the replica mirrors the primary's filtering + split-DNS.
FEATURES_DHCP_SERVER_CONFIG=false
FEATURES_DHCP_STATIC_LEASES=false
