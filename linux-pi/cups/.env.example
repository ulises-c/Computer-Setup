# Copy to .env and set the values. .env is gitignored (repo is public).
# setup.sh renders these private, machine-specific values into
# /etc/cups/cupsd.conf. The docker-compose.yml shim needs no .env.

# Space-separated Host names cupsd answers to from the LAN (ServerAlias): the
# LAN/Bonjour names family devices print to (hostname + hostname.local). The
# tailnet front door needs no alias: it reaches cupsd from loopback through
# the nginx shim, which sends Host: localhost.
CUPS_SERVER_ALIAS="<hostname> <hostname>.local"

# Canonical private IPv4 CIDR for the family LAN/WLAN. setup.sh adds it only to
# the root print location; CUPS administration remains unavailable from the LAN.
CUPS_LAN_SUBNET="<lan-subnet>/24"
