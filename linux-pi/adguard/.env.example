# Copy this file to .env and set the value. See ../README.md.

# Tailscale auth for the decoupled UI sidecar (adguard-pi-ts) — same OAuth client
# secret as the other sidecars (needs the Auth Keys scope + tag:container in the
# ACL). Only the HTTPS admin UI depends on this; AdGuard's :53 DNS does not.
TS_AUTHKEY=
