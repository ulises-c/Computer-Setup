<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>net.computer-setup.rs-sdk-portal-sync</string>
    <key>ProgramArguments</key><array>
        <string>@PYTHON@</string><string>@SYNC@</string><string>push</string>
        <string>--host</string><string>@SSH_HOST@</string>
        <string>@CURATED_ARG@</string>
    </array>
    <key>EnvironmentVariables</key><dict>
        <key>PATH</key><string>@BREW@/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TMPDIR</key><string>@HOME@/Library/Caches/computer-setup/rs-sdk-portal</string>
        <key>PYTHONDONTWRITEBYTECODE</key><string>1</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>StartInterval</key><integer>120</integer>
    <key>ProcessType</key><string>Background</string>
    <key>Nice</key><integer>10</integer>
    <key>StandardOutPath</key><string>@LOG_DIR@/rs-sdk-portal-sync.log</string>
    <key>StandardErrorPath</key><string>@LOG_DIR@/rs-sdk-portal-sync.log</string>
</dict></plist>
