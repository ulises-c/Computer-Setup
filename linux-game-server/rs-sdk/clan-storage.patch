+            this.addLog(clan.id, who, 'leave');
+            this.bump(clan.id);
+            return clan;
+        });
+    }
+
+    kick(actor: string, target: string): { clan: Clan; target: string } {
+        const by = safeName(actor);
+        const who = safeName(target);
