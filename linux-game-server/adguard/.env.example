# Copy to .env (mode 600) and fill in. Read by setup.sh and by compose for
# interpolation only; never passed into the container.
LAN_IP=<game-lan-ip>
# Optional; detected from the default route when empty.
LAN_CIDR=
# The Pi's adguardhome-sync logs in with these (REPLICA2_USERNAME/PASSWORD).
# Single-quote the password if it contains shell metacharacters; 8+ characters.
ADGUARD_USER=<admin-user>
ADGUARD_PASSWORD=<admin-password>
