# setup.sh creates machine-local values here. This file is sourced by Bash.
DRAGONWILDS_INSTALL_DIR=/home/<username>/games/dragonwilds
SERVICE_USER=<username>
STEAMCMD=/home/<username>/.local/share/steamcmd/steamcmd.sh
SERVER_PORT=7777
LAN_CIDR=
# Keep automatic restarts off until backups and migration have been verified.
AUTO_UPDATE_RESTART=false
# Private operator copy; the game reads WorldPassword from DedicatedServer.ini.
WORLD_PASSWORD=
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
