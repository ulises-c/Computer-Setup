// Lets the 2004Scape maintenance job run the game backup and its restore check
// while the games are stopped: start of those two units only, for this user only.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.user == "@USER@" &&
      (action.lookup("unit") == "game-backup.service" ||
       action.lookup("unit") == "game-backup-restore-check.service") &&
      action.lookup("verb") == "start") {
    return polkit.Result.YES;
  }
});
