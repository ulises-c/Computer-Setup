# Interface and subnet the LAN firewall rules are scoped to (e.g. enp2s0, <lan-cidr>).
LAN_IFACE=
LAN_CIDR=

# Maintenance (maintenance.sh, installed by install-maintenance-timer.sh). Every
# MAINTENANCE_DAY (Mon..Sun), the games count down, go down before the next
# game backup (normally 03:00), are backed up, verified, updated and restarted.
# Pending updates wait for that weekly window. AUTO_UPDATE=false skips updates
# but keeps the weekly restart. Other nights the backup stays live. Players get
# COUNTDOWN_MINUTES (1-60) of in-game countdown.
AUTO_UPDATE=true
MAINTENANCE_DAY=Mon
COUNTDOWN_MINUTES=10

# Optional ntfy alerts for maintenance results (this file is sourced by bash: no bare < >).
# e.g. https://ntfy.<tailnet>.ts.net
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
