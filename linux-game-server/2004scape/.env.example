# Interface and subnet the LAN firewall rules are scoped to (e.g. enp2s0, <lan-cidr>).
LAN_IFACE=
LAN_CIDR=

# Nightly update (update.sh, installed by install-update-timer.sh). Set
# AUTO_UPDATE=false to only be notified of updates. Players get this many
# minutes of in-game countdown before the servers go down.
AUTO_UPDATE=true
UPDATE_COUNTDOWN_MINUTES=10

# Optional ntfy alerts for update results (this file is sourced by bash: no bare < >).
# e.g. https://ntfy.<tailnet>.ts.net
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
