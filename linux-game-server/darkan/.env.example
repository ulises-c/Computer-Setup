# Darkan (2012 / build 727) on the game server. setup.sh copies this to .env
# (mode 600), fills the blank secrets, DARKAN_UID/GID, DARKAN_LOBBY_OWNER and,
# while it still holds the placeholder, DARKAN_PUBLIC_HOST from Tailscale.

# Clean upstream checkout the image is built from, pinned to one commit. The
# fork (gitlab.com/ulises-c/darkan-server) carries any local changes; the
# server itself builds upstream plus this directory's image layer.
DARKAN_SOURCE_URL=https://gitlab.com/darkanrs/server.git
DARKAN_SOURCE_DIR=/home/<username>/github/darkan-server
DARKAN_SOURCE_REF=63e80b6c9457f75eec97a7a55505d767c8ad2c1f
# The submodule's URL is relative (../cache-unpacked.git); pin it to upstream
# so a checkout of a fork does not need its own copy of the multi-GB cache.
DARKAN_CACHE_SOURCE_URL=https://gitlab.com/darkanrs/cache-unpacked.git

# Mongo data, the lobby's packed cache and the world's persistent state.
DARKAN_DATA_DIR=/home/<username>/games/darkan

# Address the lobby advertises in the world list; clients must reach it.
DARKAN_PUBLIC_HOST=<game-host>.<tailnet>.ts.net

# Host-network ports, off the RS-SDK (43595) and Lost City (43594) defaults.
# Clients use the lobby port in the launcher's "Custom lobby" field.
DARKAN_LOBBY_PORT=43620
DARKAN_WORLD_PORT=43621
DARKAN_LOBBY_API_PORT=4040
DARKAN_MONGO_PORT=27027

DARKAN_SERVER_NAME=Darkan
DARKAN_WORLD_ID=1
DARKAN_WORLD_NAME=Darkan
DARKAN_WORLD_ACTIVITY=
DARKAN_XP_RATE=1
DARKAN_DROP_MODIFIER=1.0
# World-list bot flag: lets the Darkan client's bot feature run on this world.
DARKAN_BOTS_ALLOWED=true
# IPs/CIDRs whose headless " Bot" logins get the passwordless bot profile.
DARKAN_BOT_IP_WHITELIST=

DARKAN_LOBBY_JAVA_OPTS=-Xms1G -Xmx4G -XX:+UseG1GC
DARKAN_WORLD_JAVA_OPTS=-Xms1G -Xmx4G -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# Filled by setup.sh.
DARKAN_UID=
DARKAN_GID=
DARKAN_LOBBY_OWNER=
DARKAN_MONGO_PASSWORD=
DARKAN_SOCIAL_GATEWAY_TOKEN=
DARKAN_WORLD_LOGIN_TOKEN_SECRET=
DARKAN_API_KEY=

# Firewall scope for activate.sh (same values as 2004scape/.env).
LAN_IFACE=
LAN_CIDR=
