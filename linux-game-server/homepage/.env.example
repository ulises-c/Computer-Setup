# Created by setup.sh. Add the actual host's Tailscale DNS name, without a trailing dot.
HOMEPAGE_ALLOWED_HOSTS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,<hostname>,<hostname>.<tailnet>.ts.net
# Other servers' homepages, for the Servers cards.
HOMEPAGE_VAR_MAIN_HOMEPAGE_DOMAIN=homepage.<tailnet>.ts.net
HOMEPAGE_VAR_PI_HOMEPAGE_DOMAIN=homepage-pi.<tailnet>.ts.net
