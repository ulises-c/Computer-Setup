# Created by setup.sh. Add the actual host's Tailscale DNS name, without a trailing dot.
HOMEPAGE_ALLOWED_HOSTS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,<hostname>,<hostname>.<tailnet>.ts.net
# This host's tailnet name (scaffolded); its other web UIs are paths or ports on it.
HOMEPAGE_VAR_GAME_HOMEPAGE_DOMAIN=<hostname>.<tailnet>.ts.net
# Other servers' homepages, for the Servers cards.
HOMEPAGE_VAR_MAIN_HOMEPAGE_DOMAIN=homepage.<tailnet>.ts.net
HOMEPAGE_VAR_PI_HOMEPAGE_DOMAIN=homepage-pi.<tailnet>.ts.net
# The Pi's Glances, on its own tailnet node (server-base/serve.sh in linux-pi/)
HOMEPAGE_VAR_PI_GLANCES_URL=https://<pi-hostname>.<tailnet>.ts.net/glances
# The main server's Glances, for the live stats on its Servers card.
HOMEPAGE_VAR_MAIN_GLANCES_URL=https://glances.<tailnet>.ts.net
# The main server's services, for the Shared services cards.
HOMEPAGE_VAR_UPTIMEKUMA_DOMAIN=uptime-kuma.<tailnet>.ts.net
HOMEPAGE_VAR_NTFY_DOMAIN=ntfy.<tailnet>.ts.net
HOMEPAGE_VAR_FORGEJO_DOMAIN=forgejo.<tailnet>.ts.net
HOMEPAGE_VAR_ADGUARD_DOMAIN=adguard.<tailnet>.ts.net
HOMEPAGE_VAR_IMMICH_DOMAIN=immich.<tailnet>.ts.net
HOMEPAGE_VAR_SYNCTHING_DOMAIN=syncthing.<tailnet>.ts.net
