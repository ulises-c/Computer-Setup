# Copy to .env (gitignored repo-wide) and fill in. Every value here is
# identifying, which is why none of it lives in a tracked file.

# Private skill repos: work skills and personal/general skills are kept apart
# so work IP never lands in the personal repo (enforced by `hermes-skills scan`
# and a pre-commit hook install.sh writes into each clone).
HERMES_SKILLS_WORK_REMOTE=ssh://git@<forgejo-host>/<work-account>/hermes-skills-work.git
HERMES_SKILLS_WORK_DIR=$HOME/forgejo/hermes-skills-work
HERMES_SKILLS_PERSONAL_REMOTE=ssh://git@<forgejo-host>/<personal-account>/hermes-skills-personal.git
HERMES_SKILLS_PERSONAL_DIR=$HOME/forgejo/hermes-skills-personal

# Optional per-repo commit identity (otherwise the global git identity is used).
HERMES_SKILLS_WORK_GIT_EMAIL=
HERMES_SKILLS_PERSONAL_GIT_EMAIL=

# Extended regex (case-insensitive) of terms that mark content as work IP:
# company names, internal project codenames, internal hostnames. Any match
# blocks that content from the personal repo.
HERMES_SKILLS_WORK_MARKERS='<company>|<internal-project>'
