# Copy to .env (gitignored repo-wide) and fill in. Every value here is
# identifying, which is why none of it lives in a tracked file.

# --- Repos -----------------------------------------------------------------
# A repo is enabled when its REMOTE is set. Set both on a work machine; set
# only PERSONAL on a personal-only setup (skills whose content names work stay
# local there instead of being adopted).
HERMES_CONFIG_SYNC_WORK_REMOTE=ssh://git@<forgejo-host>/<work-account>/hermes-config-work.git
HERMES_CONFIG_SYNC_WORK_DIR=$HOME/forgejo/hermes-config-work
HERMES_CONFIG_SYNC_PERSONAL_REMOTE=ssh://git@<forgejo-host>/<personal-account>/hermes-config.git
HERMES_CONFIG_SYNC_PERSONAL_DIR=$HOME/forgejo/hermes-config

# Optional per-repo commit identity (otherwise the global git identity is used).
HERMES_CONFIG_SYNC_WORK_GIT_EMAIL=
HERMES_CONFIG_SYNC_PERSONAL_GIT_EMAIL=

# --- Content markers (hard block on the personal repo) -----------------------
# Any match keeps a file out of the personal repo. All three are optional.
#
# 1. Generated whole-word terms: repo names from a Bitbucket workspace, plus
#    EXTRA_TERMS, minus TERM_EXCLUDE (ordinary words that happen to be repo
#    names). Written to .work-terms (gitignored, 0600) by `install` and
#    `refresh-markers`; `verify` warns when it is over 30 days old.
HERMES_CONFIG_SYNC_BITBUCKET_WORKSPACE=
HERMES_CONFIG_SYNC_BITBUCKET_NETRC=$HOME/.netrc_bb
HERMES_CONFIG_SYNC_EXTRA_TERMS='<company> <company-domain> <work-account>'
HERMES_CONFIG_SYNC_TERM_EXCLUDE=''
# 2. Jira project keys; matched case-sensitively as issue refs (KEY-123).
HERMES_CONFIG_SYNC_JIRA_KEYS=''
# 3. Hand-written extended regex (case-insensitive) for anything a word list
#    cannot express.
HERMES_CONFIG_SYNC_WORK_MARKERS=

# --- Provenance (suggestion only) --------------------------------------------
# A skill with clean content follows where most of its edits happened (more
# than half in work sessions; a tie is personal). A session's repo is not work
# when it commits as an address
# outside these domains; otherwise it is work when its origin matches the
# pattern. The work address alone proves nothing: work-adjacent open-source
# repos commit as it too.
HERMES_CONFIG_SYNC_WORK_EMAIL_DOMAINS='<company-domain>'
HERMES_CONFIG_SYNC_WORK_REMOTE_PATTERNS='bitbucket\.org[:/]<workspace>/|/<work-account>/'

# --- Cron backup ---------------------------------------------------------------
# Where `sync` snapshots cron jobs + scripts: personal (default when that repo
# is enabled), work, or off. The host label defaults to `hostname -s`.
HERMES_CONFIG_SYNC_CRON_BACKUP=
HERMES_CONFIG_SYNC_CRON_HOST=
