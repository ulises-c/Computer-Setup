#!/usr/bin/env bash
# Deterministic sync between Hermes and private skill repos: a work repo, a
# personal repo, or both (a repo is enabled when its REMOTE is set in .env), so
# the same tool serves a work machine and a personal-only setup.
#
# The repos are the source of truth: Hermes reads them through
# skills.external_dirs, which also makes them read-only to the background
# curator, so a skill only changes through a reviewed git commit.
#
# Classification (see README): Hermes-owned skills stay local; content naming
# anything work-internal is work (hard block on the personal repo); otherwise a
# skill follows where most of its edits happened (lib/provenance.py; a tie is
# work, since misfiling work as personal is the costly mistake); the rest is
# personal. Only the content rule is enforced; the rest are suggestions.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
HERMES_CFG_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
ENV_FILE="${HERMES_SKILLS_ENV:-$HERMES_CFG_DIR/.env}"
HERMES_HOME_DIR="${HERMES_HOME:-$HOME/.hermes}"
LOCAL_SKILLS="$HERMES_HOME_DIR/skills"
KINDS=()

# sk- needs a left boundary: "task-driven-development" would otherwise match.
SECRET_PATTERNS='AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|glpat-[A-Za-z0-9_-]{20,}|xox[abeprs]-[A-Za-z0-9-]{10,}|xapp-[A-Za-z0-9-]{10,}|ATATT[A-Za-z0-9_=-]{20,}|(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

ERRORS=0
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }
err()  { printf '  [FAIL] %s\n' "$*" >&2; ERRORS=$(( ERRORS + 1 )); }
ok()   { printf '  [ OK ] %s\n' "$*"; }
warn() { printf '  [WARN] %s\n' "$*"; }
section() { printf '\n=== %s ===\n' "$*"; }

usage() {
  cat <<'EOF'
usage: hermes-skills <command>

  install              clone the enabled repos, install commit guards, refresh
                       work terms (if configured), set skills.external_dirs
  status               repo state, unadopted local skills with suggested target, collisions
  verify               status checks as pass/fail; exit 1 on any failure
  migrate [--apply]    plan (default) or perform adoption of every unadopted local skill
  adopt <skill> <work|personal>
                       move one local skill into a repo and stage it (no commit)
  classify <skill>...  explain the suggested target for local skills
  refresh-markers      regenerate the work-terms file from the Bitbucket workspace
  scan [work|personal] secret scan + work-marker scan (personal) of the working tree
  pull                 fast-forward the enabled repos from origin
  push                 scan, then push the enabled repos (refuses uncommitted changes)
  hook <work|personal> pre-commit entry point (scans the index)
EOF
}

kind_var() { local name="HERMES_SKILLS_${1^^}_$2"; printf '%s' "${!name:-}"; }
kind_dir() { kind_var "$1" DIR; }
enabled()  { local k; for k in "${KINDS[@]}"; do [[ "$k" == "$1" ]] && return 0; done; return 1; }
check_kind() {
  [[ "${1:-}" == work || "${1:-}" == personal ]] || die "kind must be 'work' or 'personal'"
  enabled "$1" || die "the $1 repo is not enabled (set HERMES_SKILLS_${1^^}_REMOTE in $ENV_FILE)"
}

load_env() {
  [[ -f "$ENV_FILE" ]] || die "missing $ENV_FILE (copy .env.example and fill it in)"
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
  local k
  for k in work personal; do
    [[ -n "$(kind_var "$k" REMOTE)" ]] || continue
    [[ -n "$(kind_dir "$k")" ]] || die "HERMES_SKILLS_${k^^}_DIR is not set in $ENV_FILE"
    KINDS+=("$k")
  done
  (( ${#KINDS[@]} )) || die "set HERMES_SKILLS_WORK_REMOTE and/or HERMES_SKILLS_PERSONAL_REMOTE in $ENV_FILE"
  TERMS_FILE="${HERMES_SKILLS_TERMS_FILE:-$HERMES_CFG_DIR/.work-terms}"
  TERMS_FILE="${TERMS_FILE/#\~/$HOME}"
}

skill_name() {
  local md="$1" name
  name="$(awk 'NR == 1 && $0 != "---" { exit }
               NR > 1 && $0 == "---" { exit }
               NR > 1 && /^name:/ { sub(/^name:[ \t]*/, ""); gsub(/^["'\'']|["'\'']$/, ""); print; exit }' "$md")"
  printf '%s' "${name:-$(basename "$(dirname "$md")")}"
}

# "<name>\t<path relative to root>" for every skill under root. Hidden dirs
# (.archive, .curator_backups, .git) are skipped by the path relative to root,
# because root itself sits under ~/.hermes. find does not descend into
# symlinked skill dirs, which belong to some other repo.
list_skills() {
  local root="$1" md rel
  [[ -d "$root" ]] || return 0
  while IFS= read -r md; do
    rel="${md#"$root"/}"
    [[ "/$rel" == */.* ]] && continue
    printf '%s\t%s\n' "$(skill_name "$md")" "$(dirname "$rel")"
  done < <(find "$root" -name SKILL.md | LC_ALL=C sort)
}

# Names Hermes itself owns: bundled, hub-installed, shipped in the source tree
# now, or shipped at any point in its history. The last catches skills Hermes
# later moved to optional-skills or made built-in, whose old seeded copies
# still sit in ~/.hermes/skills looking user-authored.
foreign_names() {
  if [[ -n "${FOREIGN_CACHE+x}" ]]; then printf '%s\n' "$FOREIGN_CACHE"; return 0; fi
  local src="${HERMES_SKILLS_HERMES_SRC:-$HERMES_HOME_DIR/hermes-agent}" sub
  {
    if [[ -f "$LOCAL_SKILLS/.bundled_manifest" ]]; then cut -d: -f1 "$LOCAL_SKILLS/.bundled_manifest"; fi
    if [[ -f "$LOCAL_SKILLS/.hub/lock.json" ]]; then jq -r '.installed | keys[]' "$LOCAL_SKILLS/.hub/lock.json"; fi
    for sub in skills optional-skills; do
      if [[ -d "$src/$sub" ]]; then find "$src/$sub" -name SKILL.md -printf '%h\n' | xargs -r -n1 basename; fi
    done
    if [[ -e "$src/.git" ]]; then
      git -C "$src" log --all --format= --name-only -- ':(glob)skills/**/SKILL.md' ':(glob)optional-skills/**/SKILL.md' \
        | sed -n 's#/SKILL\.md$##p' | xargs -r -n1 basename
    fi
  } | LC_ALL=C sort -u
}

# Local, user-authored skills that are not yet in a repo.
unadopted() {
  local foreign
  foreign="$(foreign_names)"
  list_skills "$LOCAL_SKILLS" | while IFS=$'\t' read -r name rel; do
    grep -qxF "$name" <<< "$foreign" || printf '%s\t%s\n' "$name" "$rel"
  done
}

repo_skills() { local k; for k in "${KINDS[@]}"; do list_skills "$(kind_dir "$k")/skills" | sed "s/^/$k\t/"; done; }

# --- markers ---------------------------------------------------------------
# Three sources, all optional: HERMES_SKILLS_WORK_MARKERS (hand-written ERE,
# case-insensitive), the generated terms file (whole-word, case-insensitive
# fixed strings), and Jira issue refs built from HERMES_SKILLS_JIRA_KEYS
# (case-sensitive, so "ai-1" in prose does not match project AI).

jira_ere() {
  local keys
  keys="$(tr -s ' ,' '\n' <<< "${HERMES_SKILLS_JIRA_KEYS:-}" | sed '/^$/d' | paste -sd'|')"
  if [[ -n "$keys" ]]; then printf '(^|[^A-Za-z0-9_])(%s)-[0-9]+' "$keys"; fi
}

markers_configured() { [[ -n "${HERMES_SKILLS_WORK_MARKERS:-}" || -s "$TERMS_FILE" || -n "$(jira_ere)" ]]; }

grep_dir() { local d="$1"; shift; grep -rnI --exclude-dir=.git "$@" -- "$d" 2>/dev/null; }
grep_git() {
  local d="$1" mode="$2" f=(-n -I)
  shift 2
  if [[ "$mode" == index ]]; then f+=(--cached); else f+=(--untracked); fi
  git -C "$d" grep "${f[@]}" "$@" -- . 2>/dev/null
}

# $@ = a grep runner: grep_dir <dir>  |  grep_git <dir> <index|tree>
# Prints "file:line:match" for every work marker hit.
marker_hits() {
  local j
  if [[ -n "${HERMES_SKILLS_WORK_MARKERS:-}" ]]; then "$@" -o -i -E -e "$HERMES_SKILLS_WORK_MARKERS" || true; fi
  if [[ -s "$TERMS_FILE" ]]; then "$@" -o -i -w -F -f "$TERMS_FILE" || true; fi
  j="$(jira_ere)"
  if [[ -n "$j" ]]; then "$@" -o -E -e "$j" || true; fi
}
secret_hits() { { "$@" -E -e "$SECRET_PATTERNS" || true; } | cut -d: -f1,2; }

# The same markers for lib/provenance.py, which matches them against what the
# user typed. Terms are escaped there (re.escape), not here.
export_marker_regexes() {
  HERMES_SKILLS_MARK_CI="${HERMES_SKILLS_WORK_MARKERS:-}"
  HERMES_SKILLS_MARK_CS="$(jira_ere)"
  HERMES_SKILLS_MARK_TERMS="$TERMS_FILE"
  export HERMES_SKILLS_MARK_CI HERMES_SKILLS_MARK_CS HERMES_SKILLS_MARK_TERMS
}

# stdin: skill names. stdout: "<name>\t<work edits>\t<classified edits>".
provenance() {
  if ! command -v python3 >/dev/null; then
    while IFS= read -r n; do printf '%s\t0\t0\n' "$n"; done
    return 0
  fi
  export_marker_regexes
  local names=()
  mapfile -t names
  (( ${#names[@]} )) || return 0
  python3 "$HERMES_CFG_DIR/lib/provenance.py" "${names[@]}"
}

# --- classification --------------------------------------------------------

# "<name>\t<rel>\t<work|personal|SKIP:reason>\t<why>" for each unadopted skill.
migration_plan() {
  local list prov name rel src secrets hit counts w t target why
  list="$(unadopted)"
  [[ -n "$list" ]] || return 0
  prov="$(cut -f1 <<< "$list" | provenance)"
  while IFS=$'\t' read -r name rel; do
    src="$LOCAL_SKILLS/$rel"
    secrets="$(secret_hits grep_dir "$src")"
    hit="$(marker_hits grep_dir "$src" | head -1)"
    counts="$(awk -F'\t' -v n="$name" '$1 == n { print $2 " " $3; exit }' <<< "$prov")"
    read -r w t <<< "${counts:-0 0}"
    if [[ -n "$secrets" ]]; then
      target="SKIP:possible-secret" why="$(wc -l <<< "$secrets") hit(s); see: hermes-skills classify $name"
    elif [[ -n "$hit" ]]; then
      hit="${hit##*:}"; hit="${hit#"${hit%%[[:alnum:]]*}"}"
      target=work why="content names '$hit'"
    elif (( t > 0 && w * 2 >= t )); then
      target=work why="edits: $w/$t in work sessions"
    else
      target=personal why="edits: $w/$t in work sessions"
      (( t )) || why="no work signal"
    fi
    if [[ "$target" == work ]] && ! enabled work; then target="SKIP:work"; fi
    if [[ "$target" == personal ]] && ! enabled personal; then target=work; fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$rel" "$target" "$why"
  done <<< "$list"
}

cmd_classify() {
  (( $# )) || die "usage: hermes-skills classify <skill>..."
  local plan name row rel target why
  plan="$(migration_plan)"
  for name in "$@"; do
    row="$(awk -F'\t' -v n="$name" '$1 == n' <<< "$plan")"
    if [[ -z "$row" ]]; then printf '%s: not an unadopted local skill\n' "$name"; continue; fi
    IFS=$'\t' read -r _ rel target why <<< "$row"
    printf '%s → %s (%s)\n' "$name" "$target" "$why"
    marker_hits grep_dir "$LOCAL_SKILLS/$rel" | sed "s#^$LOCAL_SKILLS/##; s/^/  marker  /" | head -10
    secret_hits grep_dir "$LOCAL_SKILLS/$rel" | sed "s#^$LOCAL_SKILLS/##; s/^/  secret  /"
  done
}

# --- repo scanning ---------------------------------------------------------

# mode: index (what is about to be committed) or tree (tracked + untracked files)
scan_repo() {
  local kind="$1" dir="$2" mode="$3" hits rc=0
  hits="$(secret_hits grep_git "$dir" "$mode")"
  if [[ -n "$hits" ]]; then
    printf 'possible secrets in %s repo (file:line, values not shown):\n%s\n' "$kind" "$hits" >&2
    rc=1
  fi
  if [[ "$kind" == personal ]]; then
    hits="$(marker_hits grep_git "$dir" "$mode")"
    if [[ -n "$hits" ]]; then
      printf 'work markers in personal repo (move these to the work repo):\n%s\n' "$hits" >&2
      rc=1
    fi
  fi
  return "$rc"
}

current_external_dirs() { hermes config get skills.external_dirs 2>/dev/null | sed -n 's/^- //p'; }
norm_path() { realpath -m "${1/#\~/$HOME}"; }

set_external_dirs() {
  local want=() e k keep json
  while IFS= read -r e; do
    keep=1
    for k in work personal; do
      if [[ -n "$(kind_dir "$k")" && "$(norm_path "$e")" == "$(norm_path "$(kind_dir "$k")/skills")" ]]; then keep=0; fi
    done
    if (( keep )); then want+=("$e"); fi
  done < <(current_external_dirs)
  for k in "${KINDS[@]}"; do want+=("$(kind_dir "$k")/skills"); done
  json="$(printf '%s\n' "${want[@]}" | jq -R . | jq -sc .)"
  hermes config set skills.external_dirs "$json"
}

write_hook() {
  local kind="$1" dir="$2" hook
  hook="$(git -C "$dir" rev-parse --git-path hooks/pre-commit)"
  [[ "$hook" == /* ]] || hook="$dir/$hook"
  printf '#!/usr/bin/env bash\n# managed by hermes-skills install\nexec %q hook %s\n' "$SELF" "$kind" > "$hook"
  chmod +x "$hook"
}

# --- commands --------------------------------------------------------------

cmd_refresh_markers() {
  local ws="${HERMES_SKILLS_BITBUCKET_WORKSPACE:-}" netrc="${HERMES_SKILLS_BITBUCKET_NETRC:-}"
  local api="${HERMES_SKILLS_BITBUCKET_API:-https://api.bitbucket.org/2.0}" url page tmp common n
  [[ -n "$ws" ]] || die "HERMES_SKILLS_BITBUCKET_WORKSPACE is not set in $ENV_FILE"
  netrc="${netrc/#\~/$HOME}"
  [[ -r "$netrc" ]] || die "HERMES_SKILLS_BITBUCKET_NETRC ($netrc) is not readable"
  tmp="$(mktemp)"
  url="$api/repositories/$ws?pagelen=100&fields=next,values.slug"
  while [[ -n "$url" ]]; do
    page="$(curl -fsS --netrc-file "$netrc" "$url")" || { rm -f "$tmp"; die "Bitbucket request failed; terms file left unchanged"; }
    jq -r '.values[].slug' <<< "$page" >> "$tmp"
    url="$(jq -r '.next // empty' <<< "$page")"
  done
  tr ' ,' '\n' <<< "${HERMES_SKILLS_EXTRA_TERMS:-}" >> "$tmp"
  tr '[:upper:]' '[:lower:]' < "$tmp" | sed '/^$/d' \
    | grep -vxF -f <(tr ' ,' '\n' <<< "${HERMES_SKILLS_TERM_EXCLUDE:-}" | tr '[:upper:]' '[:lower:]' | sed '/^$/d') \
    | LC_ALL=C sort -u > "$tmp.new" || true
  rm -f "$tmp"
  [[ -s "$tmp.new" ]] || { rm -f "$tmp.new"; die "no terms fetched; terms file left unchanged"; }
  chmod 600 "$tmp.new"
  mv "$tmp.new" "$TERMS_FILE"
  n="$(wc -l < "$TERMS_FILE")"
  printf 'Wrote %d work terms to %s\n' "$n" "$TERMS_FILE"
  if [[ -r /usr/share/dict/words ]]; then
    common="$(grep -ixF -f "$TERMS_FILE" /usr/share/dict/words | tr '[:upper:]' '[:lower:]' | LC_ALL=C sort -u | paste -sd' ' || true)"
    if [[ -n "$common" ]]; then
      warn "ordinary words among the terms (add to HERMES_SKILLS_TERM_EXCLUDE if they flag general skills): $common"
    fi
  fi
}

cmd_install() {
  local k dir remote email
  for k in "${KINDS[@]}"; do
    dir="$(kind_dir "$k")"; remote="$(kind_var "$k" REMOTE)"; email="$(kind_var "$k" GIT_EMAIL)"
    if [[ ! -d "$dir/.git" ]]; then
      mkdir -p "$(dirname "$dir")"
      git clone "$remote" "$dir" || die "clone of the $k repo failed; create it on the server first"
    elif [[ "$(git -C "$dir" remote get-url origin)" != "$remote" ]]; then
      die "$dir origin is $(git -C "$dir" remote get-url origin), expected $remote"
    fi
    mkdir -p "$dir/skills"
    if [[ -n "$email" ]]; then git -C "$dir" config user.email "$email"; fi
    write_hook "$k" "$dir"
    printf 'Ready: %s repo → %s\n' "$k" "$dir"
  done
  if [[ -n "${HERMES_SKILLS_BITBUCKET_WORKSPACE:-}" ]]; then
    ( cmd_refresh_markers ) || warn "work-terms refresh failed; keeping the existing file"
  fi
  set_external_dirs
}

cmd_status() {
  local k dir counts dirty plan
  section repos
  for k in "${KINDS[@]}"; do
    dir="$(kind_dir "$k")"
    if [[ ! -d "$dir/.git" ]]; then warn "$k: not cloned ($dir) — run: hermes-skills install"; continue; fi
    dirty="$(git -C "$dir" status --porcelain | wc -l)"
    counts="$(git -C "$dir" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null || printf 'n/a')"
    printf '  %-9s %s  head=%s  behind/ahead=%s  uncommitted=%s  skills=%s\n' "$k" "$dir" \
      "$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || printf 'empty')" \
      "${counts//$'\t'//}" "$dirty" "$(list_skills "$dir/skills" | wc -l)"
  done
  section "unadopted local skills (suggested target)"
  plan="$(migration_plan)"
  if [[ -n "$plan" ]]; then cut -f1,3,4 <<< "$plan" | column -t -s $'\t' | sed 's/^/  /'; else printf '  none\n'; fi
  section "name collisions (Hermes refuses ambiguous names)"
  collisions | sed 's/^/  /'
}

collisions() {
  local repo local_names dup found=0
  repo="$(repo_skills)"
  local_names="$(list_skills "$LOCAL_SKILLS" | cut -f1)"
  while IFS=$'\t' read -r kind name rel; do
    [[ -n "$name" ]] || continue
    if grep -qxF "$name" <<< "$local_names"; then
      printf '%s: in %s repo (%s) and in %s\n' "$name" "$kind" "$rel" "$LOCAL_SKILLS"; found=1
    fi
  done <<< "$repo"
  dup="$(cut -f2 <<< "$repo" | sed '/^$/d' | LC_ALL=C sort | uniq -d)"
  if [[ -n "$dup" ]]; then printf '%s: present in both repos\n' "$dup"; found=1; fi
  if (( ! found )); then printf 'none\n'; fi
}

cmd_verify() {
  local k dir hook ext name rel md c age
  section repos
  for k in "${KINDS[@]}"; do
    dir="$(kind_dir "$k")"
    if [[ ! -d "$dir/.git" ]]; then err "$k repo not cloned at $dir"; continue; fi
    if [[ "$(git -C "$dir" remote get-url origin)" == "$(kind_var "$k" REMOTE)" ]]; then ok "$k origin"; else err "$k origin mismatch"; fi
    hook="$(git -C "$dir" rev-parse --git-path hooks/pre-commit)"
    [[ "$hook" == /* ]] || hook="$dir/$hook"
    if grep -q "hermes-skills hook $k\$" "$hook" 2>/dev/null; then ok "$k pre-commit guard"; else err "$k pre-commit guard missing"; fi
    if scan_repo "$k" "$dir" tree; then ok "$k scan clean"; else err "$k scan found problems"; fi
    if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then warn "$k has uncommitted changes"; fi
    while IFS=$'\t' read -r name rel; do
      md="$dir/skills/$rel/SKILL.md"
      if [[ "$name" != "$(basename "$rel")" ]]; then err "$k: $rel/SKILL.md name '$name' differs from its directory"; fi
      if ! grep -q '^description:' "$md"; then err "$k: $rel/SKILL.md has no description"; fi
    done < <(list_skills "$dir/skills")
  done
  section markers
  if [[ -n "${HERMES_SKILLS_BITBUCKET_WORKSPACE:-}" ]]; then
    if [[ -s "$TERMS_FILE" ]]; then
      age=$(( ( $(date +%s) - $(stat -c %Y "$TERMS_FILE") ) / 86400 ))
      if (( age > 30 )); then warn "work terms are $age days old; run: hermes-skills refresh-markers"; else ok "work terms ($(wc -l < "$TERMS_FILE"), ${age}d old)"; fi
    else
      err "work terms missing; run: hermes-skills refresh-markers"
    fi
  fi
  if markers_configured; then ok "work markers configured"
  elif enabled personal; then warn "no work markers configured; the personal repo guard only checks secrets"
  fi
  section config
  ext="$(current_external_dirs | while IFS= read -r e; do norm_path "$e"; done)"
  for k in "${KINDS[@]}"; do
    if grep -qxF "$(norm_path "$(kind_dir "$k")/skills")" <<< "$ext"; then ok "external_dirs has $k"; else err "external_dirs is missing the $k repo"; fi
  done
  section collisions
  c="$(collisions)"
  if [[ "$c" == none ]]; then ok "no name collisions"; else while IFS= read -r line; do err "$line"; done <<< "$c"; fi
  printf '\n'
  if (( ERRORS )); then printf '%d check(s) failed\n' "$ERRORS" >&2; exit 1; fi
  printf 'all checks passed\n'
}

cmd_adopt() {
  local name="${1:-}" kind="${2:-}" rel src dest dir match hits
  [[ -n "$name" ]] || die "usage: hermes-skills adopt <skill> <work|personal>"
  check_kind "$kind"
  dir="$(kind_dir "$kind")"
  [[ -d "$dir/.git" ]] || die "$kind repo not cloned; run: hermes-skills install"
  match="$(unadopted | awk -F'\t' -v n="$name" '$1 == n')"
  [[ -n "$match" ]] || die "'$name' is not an unadopted local skill (see: hermes-skills status)"
  (( $(wc -l <<< "$match") == 1 )) || die "'$name' matches more than one local skill:"$'\n'"$match"
  rel="$(cut -f2 <<< "$match")"
  src="$LOCAL_SKILLS/$rel"
  dest="$dir/skills/$rel"
  if repo_skills | cut -f2 | grep -qxF "$name"; then die "'$name' already exists in a repo"; fi
  [[ ! -e "$dest" ]] || die "$dest already exists"
  hits="$(secret_hits grep_dir "$src")"
  [[ -z "$hits" ]] || die "possible secret in $src (file:line): $(tr '\n' ' ' <<< "$hits")"
  if [[ "$kind" == personal ]]; then
    hits="$(marker_hits grep_dir "$src" | head -1)"
    [[ -z "$hits" ]] || die "'$name' contains work markers ('${hits##*:}'); it can only go to the work repo"
  fi
  mkdir -p "$(dirname "$dest")"
  mv "$src" "$dest"
  git -C "$dir" add -- "skills/$rel"
  printf 'Adopted: %s → %s repo (skills/%s), staged\n' "$name" "$kind" "$rel"
}

cmd_migrate() {
  local apply=0 plan name rel target why
  [[ "${1:-}" == --apply ]] && apply=1
  plan="$(migration_plan)"
  [[ -n "$plan" ]] || { printf 'nothing to migrate\n'; return 0; }
  if (( ! apply )); then
    column -t -s $'\t' <<< "$plan"
    printf '\ndry run; re-run with --apply to move these (SKIP rows are left in place).\n'
    printf 'Override one suggestion with: hermes-skills adopt <skill> <work|personal>\n'
    return 0
  fi
  while IFS=$'\t' read -r name rel target why; do
    case "$target" in
      SKIP:*) printf 'Skipped: %s (%s: %s)\n' "$name" "${target#SKIP:}" "$why" ;;
      *) cmd_adopt "$name" "$target" ;;
    esac
  done <<< "$plan"
  printf '\nReview with: git -C <repo> diff --cached --stat, then commit in each repo.\n'
}

cmd_scan() {
  local k rc=0
  local kinds=("${KINDS[@]}")
  if [[ -n "${1:-}" ]]; then check_kind "$1"; kinds=("$1"); fi
  for k in "${kinds[@]}"; do
    if scan_repo "$k" "$(kind_dir "$k")" tree; then printf '%s: clean\n' "$k"; else rc=1; fi
  done
  return "$rc"
}

cmd_pull() {
  local k dir
  for k in "${KINDS[@]}"; do
    dir="$(kind_dir "$k")"
    git -C "$dir" fetch --quiet origin
    if git -C "$dir" rev-parse --verify --quiet '@{u}' >/dev/null; then
      git -C "$dir" merge --ff-only --quiet '@{u}'
    fi
    printf 'Pulled: %s @ %s\n' "$k" "$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || printf 'empty')"
  done
}

cmd_push() {
  local k dir
  for k in "${KINDS[@]}"; do
    dir="$(kind_dir "$k")"
    [[ -z "$(git -C "$dir" status --porcelain)" ]] || die "$k repo has uncommitted changes; commit or discard first"
    scan_repo "$k" "$dir" tree || die "$k scan failed; not pushing"
  done
  for k in "${KINDS[@]}"; do
    dir="$(kind_dir "$k")"
    git -C "$dir" rev-parse --verify --quiet HEAD >/dev/null || { printf 'Skipped: %s (no commits)\n' "$k"; continue; }
    git -C "$dir" push --quiet -u origin HEAD
    printf 'Pushed: %s @ %s\n' "$k" "$(git -C "$dir" rev-parse --short HEAD)"
  done
}

cmd_hook() {
  check_kind "${1:-}"
  scan_repo "$1" "$PWD" index || die "commit blocked by hermes-skills"
}

main() {
  local cmd="${1:-}"
  [[ -n "$cmd" ]] || { usage; exit 2; }
  shift
  case "$cmd" in
    -h|--help|help) usage; return 0 ;;
  esac
  command -v jq >/dev/null || die "jq is required"
  load_env
  case "$cmd" in
    status|verify|migrate|adopt|classify) FOREIGN_CACHE="$(foreign_names)" ;;
  esac
  case "$cmd" in
    install)  cmd_install ;;
    status)   cmd_status ;;
    verify)   cmd_verify ;;
    migrate)  cmd_migrate "$@" ;;
    adopt)    cmd_adopt "$@" ;;
    classify) cmd_classify "$@" ;;
    refresh-markers) cmd_refresh_markers ;;
    scan)     cmd_scan "$@" ;;
    pull)     cmd_pull ;;
    push)     cmd_push ;;
    hook)     cmd_hook "$@" ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
