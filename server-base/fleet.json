{
  "servers": [
    {
      "key": "main",
      "dir": "linux-server",
      "name": "main server",
      "icon": "sh-ubuntu.svg",
      "description": "NAS — storage, media and core services",
      "domain_var": "MAIN_HOMEPAGE_DOMAIN",
      "glances_url": "{{HOMEPAGE_VAR_MAIN_GLANCES_URL}}"
    },
    {
      "key": "pi",
      "dir": "linux-pi",
      "name": "pi",
      "icon": "sh-raspberry-pi.svg",
      "description": "MotionEye, CUPS and backup DNS",
      "domain_var": "PI_HOMEPAGE_DOMAIN",
      "glances_url": null
    },
    {
      "key": "game",
      "dir": "linux-game-server",
      "name": "game server",
      "icon": "/icons/dragonwilds.ico",
      "description": "RuneScape: Dragonwilds",
      "domain_var": "GAME_HOMEPAGE_DOMAIN",
      "glances_url": "https://{{HOMEPAGE_VAR_GAME_HOMEPAGE_DOMAIN}}/glances",
      "status": {
        "local_url": "http://127.0.0.1:8096/dragonwilds-status.json",
        "remote_url": "https://{{HOMEPAGE_VAR_GAME_HOMEPAGE_DOMAIN}}/dragonwilds/dragonwilds-status.json",
        "mappings": [
          {"field": "status", "label": "World", "format": "text"},
          {"field": "online_capacity", "label": "Players", "format": "text"},
          {"field": "uptime_seconds", "label": "Uptime", "format": "duration"}
        ]
      }
    }
  ],
  "shared_services": {
    "group": "Shared services",
    "host": "main",
    "services": [
      {"name": "uptime kuma", "icon": "sh-uptime-kuma.svg", "description": "Uptime monitor for every server", "domain_var": "UPTIMEKUMA_DOMAIN",
       "widget": {"type": "uptimekuma", "slug": "default"}},
      {"name": "ntfy", "icon": "sh-ntfy.svg", "description": "Push notifications", "domain_var": "NTFY_DOMAIN"},
      {"name": "forgejo", "icon": "sh-forgejo.svg", "description": "Self-hosted git", "domain_var": "FORGEJO_DOMAIN"},
      {"name": "adguard home", "icon": "sh-adguard-home.svg", "description": "Primary DNS ad blocker", "domain_var": "ADGUARD_DOMAIN"},
      {"name": "immich", "icon": "sh-immich.svg", "description": "Photo + video backup", "domain_var": "IMMICH_DOMAIN"},
      {"name": "syncthing", "icon": "sh-syncthing.svg", "description": "File sync", "domain_var": "SYNCTHING_DOMAIN"}
    ]
  },
  "hosts": {
    "linux-server": {
      "title": "Home Server",
      "accents": {"Servers": "indigo", "Management": "blue", "Network": "teal", "Storage": "amber", "NAS": "orange"}
    },
    "linux-pi": {
      "title": "Pi — Secondary Server",
      "accents": {"Servers": "indigo", "Management": "blue", "Pi Services": "emerald", "Shared services": "cyan"}
    },
    "linux-game-server": {
      "title": "Game Server",
      "accents": {"Servers": "indigo", "Game server": "blue", "Games": "rose", "Shared services": "cyan"}
    }
  }
}
