# Copy this file to .env and update the values.
# HOMEPAGE_VAR_* variables are available in config YAMLs as {{HOMEPAGE_VAR_*}}

# Used in services.yaml for service hrefs — use hostname (avahi mDNS) to avoid hardcoding an IP
# Access the dashboard at http://<hostname>.local:3000
HOMEPAGE_VAR_SERVER_IP=<hostname>.local

# Tailscale widget uses a local proxy (linux-server/tailscale-proxy) — configure credentials there

# AdGuard Home — credentials for the dashboard stats widget
HOMEPAGE_VAR_ADGUARD_USER=
# Note: escape literal $ in passwords with $$ (e.g. p@$$word) to prevent Docker Compose interpolation
HOMEPAGE_VAR_ADGUARD_PASS=

# Syncthing — API key from web UI → Actions → Settings → API Key
HOMEPAGE_VAR_SYNCTHING_KEY=

# The server's host node MagicDNS name. Every card link to a path
# (https://<this>/glances/) or a registry port (https://<this>:8444/) on this
# server is built from it; see ../HTTPS.md. setup.sh fills it from
# tailscale status. Widgets don't use it: they call loopback backends.
HOMEPAGE_VAR_HOMEPAGE_DOMAIN=<server>.<tailnet>.ts.net

# Forgejo — the svc:forgejo Tailscale Service name, per ../HTTPS.md;
# API token from Forgejo → Settings → Applications
HOMEPAGE_VAR_FORGEJO_DOMAIN=forgejo.<tailnet>.ts.net
HOMEPAGE_VAR_FORGEJO_TOKEN=

# ntfy — the svc:ntfy Tailscale Service name, per ../HTTPS.md
HOMEPAGE_VAR_NTFY_DOMAIN=ntfy.<tailnet>.ts.net

# qBittorrent Web UI login, used by the homepage widget.
HOMEPAGE_VAR_QBITTORRENT_USERNAME=admin
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=

# Immich — the svc:immich Tailscale Service name, per ../HTTPS.md.
# API key from Immich → Account Settings → API Keys, with the server.statistics
# permission (needs an admin account). Used by the homepage widget.
HOMEPAGE_VAR_IMMICH_DOMAIN=immich.<tailnet>.ts.net
HOMEPAGE_VAR_IMMICH_KEY=

# Raspberry Pi secondary-server homepage — the Pi host node's MagicDNS name,
# served from linux-pi/homepage at its root. The "Secondary Server (Pi)" card
# links to it and siteMonitor-pings it.
HOMEPAGE_VAR_PI_HOMEPAGE_DOMAIN=<pi-hostname>.<tailnet>.ts.net
# Pi hostname shown as the card's description prefix (kept out of tracked config).
HOMEPAGE_VAR_PI_HOSTNAME=<pi-hostname>

# Server hostname — used to build HOMEPAGE_ALLOWED_HOSTS in docker-compose.yml
HOSTNAME=<hostname>
# Server LAN IP — used in HOMEPAGE_ALLOWED_HOSTS to allow direct IP access
SERVER_IP=<server-ip>
# Tailscale HTTPS hostname — run: tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//'
TAILSCALE_HOSTNAME=<server>.<tailnet>.ts.net
