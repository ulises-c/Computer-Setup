# Copy to .env (gitignored) and fill in. Webhook URLs are secrets: anyone with
# one can post to that channel.

# ntfy server to read from (no trailing slash) and the topics to relay. ntfy has
# no wildcard subscription, so a new topic must be added here.
NTFY_URL=https://ntfy.<tailnet>.ts.net
RELAY_TOPICS=server-backup,server-dns,server-dragonwilds,server-runner,server-ups,game-backup,game-dragonwilds,pi-backup
# Only needed if ntfy access control is ever enabled.
NTFY_TOKEN=

# One Discord webhook per server (Channel settings -> Integrations -> Webhooks).
# Routing is by topic prefix: server-*, game-*, pi-*, nas-*. DEFAULT catches any other
# prefix; leave it empty to drop those.
DISCORD_WEBHOOK_SERVER=
DISCORD_WEBHOOK_GAME=
DISCORD_WEBHOOK_PI=
DISCORD_WEBHOOK_NAS=
DISCORD_WEBHOOK_DEFAULT=

# Owner of ./state, which holds the last relayed message id.
RELAY_UID=1000
RELAY_GID=1000
