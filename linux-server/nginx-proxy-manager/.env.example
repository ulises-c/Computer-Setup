# Copy this file to .env and set the value. See ../HTTPS.md for the full setup.

# The server's LAN IP. NPM's :80, :443 and :81 publish only on this address,
# never on all interfaces, so they can't collide with host tailscale serve on
# :443 (docs/ONE_NODE_PER_HOST.md D7). Give the server a fixed LAN address (a
# DHCP reservation): docker refuses to start NPM if this IP is not on the host.
NPM_BIND_IP=<server-ip>
