[Unit]
Description=Server backup (restic → external drive)
RequiresMountsFor=/mnt/wd1tb
After=network-online.target docker.service
OnFailure=backup-failure.service

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash @BACKUP_SCRIPT@
Environment=HOME=/root
Environment=BACKUP_HOST_DIR=@BACKUP_HOST_DIR@
Environment=BACKUP_SAVE_SCRIPT=@BACKUP_SAVE_SCRIPT@
Environment=BACKUP_DRAGONWILDS_INSTALL_DIR=@BACKUP_DRAGONWILDS_INSTALL_DIR@
Environment=BACKUP_FORGEJO_DATA_PATH=@BACKUP_FORGEJO_DATA_PATH@
Environment=STATUS_JSON=@BACKUP_STATUS_JSON@
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
