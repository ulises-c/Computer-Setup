# Copy this file to .env and set the value. See ../HTTPS.md for the full setup.

# Tailscale auth for the sidecar — same OAuth client secret as the other sidecars
# (needs the Auth Keys scope + tag:container in the ACL).
TS_AUTHKEY=

# --- DNS watchdog (dns-watchdog.sh, installed by: sudo bash setup.sh) ---------
# Restarts adguardhome when host :53 stops answering; see linux-server/README.md.
# ntfy alerts (optional). Quoted like the other services' ntfy URLs.
# Alerts fire while AdGuard is down, so these hosts must resolve without it — a
# *.ts.net name via the host's Tailscale DNS (100.100.100.100) does.
NTFY_URL="https://ntfy.<tailnet>.ts.net"
NTFY_TOPIC=server-dns
NTFY_TOKEN=
# Uptime Kuma push monitor (optional): base URL through /api/push/<token>; the
# watchdog pushes up/down every minute (Heartbeat 60s, Retries 2 fits).
KUMA_PUSH_URL=
# Name probed on :53. Any reply (even SERVFAIL) counts as up — only silence is down.
WATCHDOG_PROBE_NAME=example.com
