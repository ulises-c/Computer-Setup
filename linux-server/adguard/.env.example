# Copy this file to .env and set the values. See ../HTTPS.md for how AdGuard
# is published on the host node.

# --- DNS watchdog (dns-watchdog.sh, installed by: sudo bash setup.sh) ---------
# Restarts adguardhome when host :53 stops answering; see linux-server/README.md.
# ntfy alerts (optional): ntfy on loopback, because the watchdog runs on the
# server (docs/ONE_NODE_PER_HOST.md D10). Alerts fire while AdGuard is down, and
# a loopback IP needs no DNS.
NTFY_URL="http://127.0.0.1:8103"
NTFY_TOPIC=server-dns
NTFY_TOKEN=
# Uptime Kuma push monitor (optional): base URL through /api/push/<token>, with
# the host swapped for loopback (D10); the watchdog pushes up/down every minute
# (Heartbeat 60s, Retries 2 fits).
KUMA_PUSH_URL=
# Name probed on :53. Any reply (even SERVFAIL) counts as up — only silence is down.
WATCHDOG_PROBE_NAME=example.com
