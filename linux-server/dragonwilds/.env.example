# Copy this file to .env and set the values. The .env is gitignored.
#
# Deployment plumbing only. The server's own settings — OwnerId, WorldPassword,
# ServerName, DefaultWorldName — are NOT here: they live in
#   $DRAGONWILDS_INSTALL_DIR/RSDragonwilds/Saved/Config/LinuxServer/DedicatedServer.ini
# which the server rewrites on every shutdown, so it has to stay the single source
# of truth. That file sits outside the repo; restic backs it up via Saved/Config.
# See README.md "Configure".

# Where steamcmd installs the server (~5.5 GB). Kept outside the repo.
DRAGONWILDS_INSTALL_DIR=/home/<username>/games/dragonwilds

# Account the server runs as. Defaults to the user invoking sudo.
SERVICE_USER=<username>

# steamcmd binary. The Ubuntu package installs it here.
STEAMCMD=/usr/games/steamcmd

# UDP port the server binds. A second server on this host would use 7778.
SERVER_PORT=7777

# Subnet allowed to reach the server, in addition to the tailnet. Auto-detected
# from the default route when left empty.
LAN_CIDR=

# --- Automatic build updates ------------------------------------------------
# dragonwilds-update-check.timer records the latest public build every 2 hours;
# dragonwilds-auto-update.timer restarts onto it, but only while the server is
# empty. Set false to be notified and apply it yourself.
AUTO_UPDATE_RESTART=true

# ntfy alerts for "update available", "updated", and a failed restart. Leave
# NTFY_URL empty to disable notifications entirely.
NTFY_URL=https://ntfy.<tailnet>.ts.net
NTFY_TOPIC=server-dragonwilds
NTFY_TOKEN=
