# Copy this file to .env and set the values. The .env is gitignored.

# Where steamcmd installs the server (~5.5 GB). Kept outside the repo.
DRAGONWILDS_INSTALL_DIR=/home/<username>/games/dragonwilds

# Account the server runs as. Defaults to the user invoking sudo.
SERVICE_USER=<username>

# steamcmd binary. The Ubuntu package installs it here.
STEAMCMD=/usr/games/steamcmd

# UDP port the server binds. A second server on this host would use 7778.
SERVER_PORT=7777

# Subnet allowed to reach the server, in addition to the tailnet. Auto-detected
# from the default route when left empty.
LAN_CIDR=
