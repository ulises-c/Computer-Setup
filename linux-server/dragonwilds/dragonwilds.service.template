[Unit]
Description=RuneScape: Dragonwilds dedicated server
Documentation=https://dragonwilds.runescape.com/news/how-to-dedicated-servers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@INSTALL_DIR@

# Pull the latest build on every start. Leading "-" so a Steam outage leaves the
# server starting on the build already on disk instead of failing to come up.
# flock: dragonwilds-update-check.timer also runs steamcmd, and two instances
# sharing ~/.steam can trip over each other.
ExecStartPre=-/usr/bin/flock @INSTALL_DIR@/.steamcmd.lock @STEAMCMD@ +force_install_dir @INSTALL_DIR@ +login anonymous +app_update @APPID@ +quit
ExecStart=@INSTALL_DIR@/RSDragonwildsServer.sh -log

# The server flushes its world to Saved/Savegames on SIGTERM; give it room to
# finish before systemd escalates, otherwise a restart can lose recent progress.
KillSignal=SIGTERM
TimeoutStopSec=120

Restart=on-failure
RestartSec=15
LimitNOFILE=65535

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
