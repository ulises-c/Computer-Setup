[Unit]
Description=RuneScape: Dragonwilds dedicated server
Documentation=https://dragonwilds.runescape.com/news/how-to-dedicated-servers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@INSTALL_DIR@

# The backup gate and download both run inside the start job. A patch has taken
# a little over two hours in practice, and the backup service itself allows two
# hours, so leave headroom for both before systemd gives up.
TimeoutStartSec=5h

# A restart stops the old process first; this root-only helper then waits for a
# clean, off-host backup before SteamCMD can modify the installation. The `+`
# prefix is required because the game service itself runs unprivileged.
ExecStartPre=+/usr/bin/systemctl start --wait dragonwilds-pre-update-backup.service

# Pull the latest build on every start. Leading "-" so a Steam outage leaves the
# server starting on the build already on disk instead of failing to come up.
# flock: dragonwilds-update-check.timer also runs steamcmd, and two instances
# sharing ~/.steam can trip over each other.
ExecStartPre=-/usr/bin/flock @INSTALL_DIR@/.steamcmd.lock @STEAMCMD@ +force_install_dir @INSTALL_DIR@ +login anonymous +app_update @APPID@ +quit
# The launcher forwards its arguments to the Unreal binary; -port is the standard
# engine flag. Without it the server takes Unreal's default, 7777.
# MAX_PLAYERS is an explicit Unreal override; keep it at 6 unless intentionally
# testing a higher, unsupported value.
ExecStart=@INSTALL_DIR@/RSDragonwildsServer.sh -log -port=@SERVER_PORT@ -ini:Game:[/Script/Engine.GameSession]:MaxPlayers=@MAX_PLAYERS@

# The server flushes its world to Saved/SaveGames on SIGTERM; give it room to
# finish before systemd escalates, otherwise a restart can lose recent progress.
KillSignal=SIGTERM
TimeoutStopSec=120
# Record forced or otherwise unclean termination outside the checkout. The next
# start refuses to update until the operator has acknowledged the failed stop.
ExecStopPost=+/usr/bin/bash -c 'install -d -o root -g root -m 755 /run/dragonwilds; if [[ "$${SERVICE_RESULT:-unknown}" == success ]]; then rm -f /run/dragonwilds/stop-failure; else printf "%s\n" "$${SERVICE_RESULT:-unknown}" > /run/dragonwilds/stop-failure; fi'

Restart=on-failure
RestartSec=15
LimitNOFILE=65535

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
