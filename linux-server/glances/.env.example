# Copy to .env (gitignored). Preserve the host's existing values. See ../HTTPS.md.

# Glances 4.5.2+ rejects unknown Host headers. Include every name used to reach
# its Web UI/API, including the server's MagicDNS name, which host tailscale
# serve forwards for /glances/. Keep real hostnames and addresses in .env only.
GLANCES_ALLOWED_HOSTS=localhost,127.0.0.1,<server>.<tailnet>.ts.net

# Backend caches: safety floors cannot be lowered by UI polling or these values.
GLANCES_FS_INTERVAL=300
GLANCES_NVME_HEALTH_INTERVAL=600
# false disables all storage hardware health/temperature. HDD health has no opt-in.
GLANCES_NVME_HEALTH_ENABLED=true
# Kernel counters only, not drive reads.
GLANCES_DISKIO_INTERVAL=60
