# Copy this file to .env and set the value. See ../HTTPS.md for the full setup.

# Tailscale auth for the sidecar — same OAuth client secret as the other sidecars
# (needs the Auth Keys scope + tag:container in the ACL).
TS_AUTHKEY=

# Glances 4.5.2+ rejects unknown Host headers. Include every LAN and tailnet name
# used to access its Web UI/API; keep real hostnames and addresses in .env only.
GLANCES_ALLOWED_HOSTS=localhost,127.0.0.1,<server-hostname>,<server-hostname>.local,<server-ip>,glances.<tailnet>.ts.net
