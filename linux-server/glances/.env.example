# Copy to .env (gitignored). Preserve the host's existing values.
# Tailscale auth for the existing sidecar; never commit the real value.
TS_AUTHKEY=

# Add the actual host/LAN/tailnet names clients use; never commit real addresses.
GLANCES_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal

# Backend caches: safety floors cannot be lowered by UI polling or these values.
GLANCES_FS_INTERVAL=300
GLANCES_NVME_HEALTH_INTERVAL=600
# false disables all storage hardware health/temperature. HDD health has no opt-in.
GLANCES_NVME_HEALTH_ENABLED=true
# Kernel counters only, not drive reads.
GLANCES_DISKIO_INTERVAL=60
