# Copy this file to .env and set the value. See ../HTTPS.md for the full setup.

# Glances 4.5.2+ rejects unknown Host headers. Include every LAN and tailnet name
# used to access its Web UI/API — including the server's MagicDNS name, which
# host tailscale serve forwards for /glances/. Keep real hostnames and addresses
# in .env only. If omitted during an upgrade, Glances permits only local proxy
# names and logs a migration warning until this value is added.
GLANCES_ALLOWED_HOSTS=localhost,127.0.0.1,<server-hostname>,<server-hostname>.local,<server-ip>,<server>.<tailnet>.ts.net
