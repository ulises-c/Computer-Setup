# Copy this file to .env and set the values. See ./README.md for the full setup.

# Tailscale auth for the sidecar — same OAuth client secret as the other sidecars
# (needs the Auth Keys scope + tag:container in the ACL). See ../HTTPS.md.
TS_AUTHKEY=

# Pinned to a major version; upgrade deliberately after reading the release notes.
# Watchtower is told to skip these containers (see docker-compose.yml).
IMMICH_VERSION=v3

# Where photos and videos live — the big one, so put it on a data drive. Immich
# writes a .immich marker in each subfolder and refuses to start if they vanish,
# so an unmounted drive fails loudly instead of filling the root disk.
UPLOAD_LOCATION=/mnt/wd14tb/immich

# Postgres data. Keep it on the local SSD (network shares are unsupported).
DB_DATA_LOCATION=./postgres

# Postgres password — letters and digits only. Generate: openssl rand -hex 24
DB_PASSWORD=

TZ=America/Los_Angeles
