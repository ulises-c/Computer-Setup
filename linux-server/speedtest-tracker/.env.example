# Required — generate with: echo "base64:$(openssl rand -base64 32)"
# (setup.sh auto-generates this when it first creates .env from this example)
APP_KEY=

# Public HTTPS URL, port included — the speedtest-tracker registry port on the
# server node (see ../HTTPS.md) — so the Laravel app builds correct links and
# assets and avoids mixed content over HTTPS.
APP_URL=https://<server>.<tailnet>.ts.net:8445
ASSET_URL=https://<server>.<tailnet>.ts.net:8445

# Cron schedule for automatic speedtests (default: every 6 hours)
SPEEDTEST_SCHEDULE=0 */6 * * *
