<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.computer-setup.glances</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BREW@/bin/glances</string>
        <string>-C</string>
        <string>@CONF@</string>
        <string>-w</string>
        <string>-B</string>
        <string>127.0.0.1</string>
        <string>-p</string>
        <string>61208</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@BREW@/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>Nice</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/glances.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/glances.log</string>
</dict>
</plist>
