# Copy to .env (gitignored). LaunchAgents shown on the Homepage cards, as
# space-separated name=label pairs. Labels that embed a username stay here.
AGENTS="glances=net.computer-setup.glances forgejo-runner=net.forgejo.runner mlx-server=net.computer-setup.mlx-server mac-backup=net.computer-setup.mac-backup hermes-gateway=ai.hermes.gateway"
